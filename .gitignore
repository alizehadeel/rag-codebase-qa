# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
*.env

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# RAG Data artifacts (cloned repos, jsonl files, vector store & BM25 indices)
**/data/*
!**/data/.gitignore
!**/data/.gitkeep

# Logs and temporary outputs
*.log
